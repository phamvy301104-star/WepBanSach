@model PagedList.IPagedList<WebBanSach.Models.Order>
@using PagedList.Mvc

@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
}

<div class="container-fluid mt-5">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>Quản Lý Đơn Hàng</h2>
        </div>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Khách Hàng</th>
                <th>Ngày Đặt</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@order.User.FullName</td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        @switch (order.Status)
                        {
                            case 0:
                                <span class="badge badge-warning">Chờ Xác Nhận</span>
                                break;
                            case 1:
                                <span class="badge badge-info">Đã Xác Nhận</span>
                                break;
                            case 2:
                                <span class="badge badge-primary">Đang Giao</span>
                                break;
                            case 3:
                                <span class="badge badge-success">Đã Giao</span>
                                break;
                            case 4:
                                <span class="badge badge-danger">Đã Hủy</span>
                                break;
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("OrderDetails", "Admin", new { id = order.OrderID })" class="btn btn-info btn-sm">Chi Tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        @Html.PagedListPager(Model, page => Url.Action("Orders", new { page = page }))
    </nav>
</div>
