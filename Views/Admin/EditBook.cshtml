@model WebBanSach.Models.Book

@{
    ViewBag.Title = "Sửa Sách";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h2>Sửa Thông Tin Sách</h2>

            @using (Html.BeginForm("EditBook", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.BookID)

                <div class="form-group">
                    @Html.LabelFor(model => model.BookTitle)
                    @Html.TextBoxFor(model => model.BookTitle, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Author)
                    @Html.TextBoxFor(model => model.Author, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Price)
                    @Html.TextBoxFor(model => model.Price, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Quantity)
                    @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control", type = "number" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.CategoryID, "Danh Mục")
                    @Html.DropDownListFor(model => model.CategoryID, 
                        ViewBag.Categories as SelectList, 
                        new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.PublisherID, "Nhà Xuất Bản")
                    @Html.DropDownListFor(model => model.PublisherID, 
                        ViewBag.Publishers as SelectList, 
                        new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.PublishedDate)
                    @Html.TextBoxFor(model => model.PublishedDate, "{0:yyyy-MM-dd}", 
                        new { @class = "form-control", type = "date" })
                </div>

                <div class="form-group">
                    <label for="imageFile">Hình Ảnh Mới (tùy chọn)</label>
                    <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <small class="form-text text-muted">Ảnh hiện tại: @Model.ImagePath</small>
                    }
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Description)
                    @Html.TextAreaFor(model => model.Description, 
                        new { @class = "form-control", rows = 5, id = "description" })
                </div>

                <button type="submit" class="btn btn-warning">Cập Nhật</button>
                <a href="@Url.Action("Books", "Admin")" class="btn btn-secondary">Hủy</a>
            }
        </div>
    </div>
</div>

<script src="//cdn.tinymce.com/4/tinymce.min.js"></script>
<script>
    tinymce.init({
        selector: '#description',
        plugins: 'link image code',
        toolbar: 'formatselect | bold italic strikethrough | link image | code'
    });
</script>
