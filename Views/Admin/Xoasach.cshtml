@model WebBanSach.Models.Book

@{
    ViewBag.Title = "Xoasach";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>XÁC NHẬN THÔNG TIN SÁCH CẦN XÓA</h2>

<h3>Bạn quyết định xóa quyển sách này?</h3>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>Tên sách</dt>
        <dd>@Html.DisplayFor(model => model.BookTitle)</dd>

        <dt>Giá bán</dt>
        <dd>@Html.DisplayFor(model => model.Price)</dd>

        <dt>Mô tả</dt>
        <dd>@Html.DisplayFor(model => model.Description)</dd>

        <dt>Ảnh bìa</dt>
        <dd>@Html.DisplayFor(model => model.ImagePath)</dd>

        <dt>Ngày cập nhật</dt>
        <dd>@Html.DisplayFor(model => model.CreatedDate)</dd>

        <dt>Số lượng tồn</dt>
        <dd>@Html.DisplayFor(model => model.Quantity)</dd>

        <dt>MaCD</dt>
        <dd>@Html.DisplayFor(model => model.CategoryID)</dd>

        <dt>MaNXB</dt>
        <dd>@Html.DisplayFor(model => model.PublisherID)</dd>
    </dl>
</div>

@using (Html.BeginForm("Xacnhanxoa", "Admin", new { id = Model.BookID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Delete" class="btn btn-danger" />
    @Html.ActionLink("Back to List", "Sach", null, new { @class = "btn btn-default" })
}
