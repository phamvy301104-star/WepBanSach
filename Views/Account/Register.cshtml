@{
    ViewBag.Title = "Dangky";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>Dang ky thanh vien</h2>

@using (Html.BeginForm())
{
    <table align="center">
        <tr style="height:40px">
            <td>Ho ten khach hang:</td>
            <td>
                @Html.TextBox("HoTen")
                @ViewData["Loi_HoTen"]
            </td>
        </tr>
        <tr style="height:40px">
            <td>Ten dang nhap:</td>
            <td>@Html.TextBox("TenDN")</td>
        </tr>
        <tr style="height:40px">
            <td>Mat khau:</td>
            <td>@Html.Password("Matkhau")</td>
        </tr>
        <tr style="height:40px">
            <td>Email:</td>
            <td>@Html.TextBox("Email")</td>
        </tr>
        <tr style="height:40px">
            <td>Dia chi:</td>
            <td>@Html.TextBox("DiaChi")</td>
        </tr>
        <tr style="height:40px">
            <td>Dien thoai:</td>
            <td>
                @Html.TextBox("DienThoai")
                @ViewData["Loi_DienThoai"]
            </td>
        </tr>
        <tr style="height:40px">
            <td>Ngay sinh:</td>
            <td><input type="date" name="NgaySinh" /></td>
        </tr>
        <tr style="height:40px">
            <td></td>
            <td><input type="Submit" value="Dang ky" /></td>
        </tr>
    </table>
}