@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>Đăng ký thành viên</h2>

@using (Html.BeginForm())
{
    <table align="center">
        <tr style="height:40px">
            <td>Họ tên khách hàng:</td>
            <td>
                @Html.TextBox("HoTen")
                @ViewData["Loi_HoTen"]
            </td>
        </tr>
        <tr style="height:40px">
            <td>Tên đăng nhập:</td>
            <td>@Html.TextBox("TenDN")</td>
        </tr>
        <tr style="height:40px">
            <td>Mật khẩu:</td>
            <td>@Html.Password("Matkhau")</td>
        </tr>
        <tr style="height:40px">
            <td>Email:</td>
            <td>@Html.TextBox("Email")</td>
        </tr>
        <tr style="height:40px">
            <td>Địa chỉ:</td>
            <td>@Html.TextBox("DiaChi")</td>
        </tr>
        <tr style="height:40px">
            <td>Điện thoại:</td>
            <td>
                @Html.TextBox("DienThoai")
                @ViewData["Loi_DienThoai"]
            </td>
        </tr>
        <tr style="height:40px">
            <td>Ngày sinh:</td>
            <td><input type="date" name="NgaySinh" /></td>
        </tr>
        <tr style="height:40px">
            <td></td>
            <td><input type="Submit" value="Đăng ký" /></td>
        </tr>
    </table>
}