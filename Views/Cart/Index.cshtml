@model List<WebBanSach.Models.CartItem>
@{
    ViewBag.Title = "Gio hang";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>Thong tin gio hang</h2>

@if (Model == null || Model.Count == 0)
{
    <p>Gio hang cua ban dang trong.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Ma sach</th>
                <th>Ten sach</th>
                <th>Anh bia</th>
                <th>So luong</th>
                <th>Don gia</th>
                <th>Thanh tien</th>
            </tr>
        </thead>
        <tbody>
            @{
                int totalQty = 0;
                decimal totalPrice = 0;
            }
            @foreach (var item in Model)
            {
                totalQty += item.Quantity;
                totalPrice += item.Quantity * item.Book.Price;
                <tr>
                    <td>@item.BookID</td>
                    <td>@item.Book.BookTitle</td>
                    <td><img src="@item.Book.ImagePath" width="60" /></td>
                    <td>@item.Quantity</td>
                    <td>@item.Book.Price.ToString("N0") VND</td>
                    <td>@((item.Quantity * item.Book.Price).ToString("N0")) VND</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="color:green; font-weight:bold">So luong sach: @totalQty</td>
                <td colspan="3" style="text-align:right; font-weight:bold">Tong tien: @totalPrice.ToString("N0") VND</td>
            </tr>
        </tfoot>
    </table>
}