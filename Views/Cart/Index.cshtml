@model List<WebBanSach.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>Thông tin giỏ hàng</h2>

@if (Model == null || Model.Count == 0)
{
    <p>Giỏ hàng của bạn đang trống.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã sách</th>
                <th>Tên sách</th>
                <th>Ảnh bìa</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @{
                int totalQty = 0;
                decimal totalPrice = 0;
            }
            @foreach (var item in Model)
            {
                totalQty += item.Quantity;
                totalPrice += item.Quantity * item.Book.Price;
                <tr>
                    <td>@item.BookID</td>
                    <td>@item.Book.BookTitle</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Book.ImagePath))
                        {
                            var imgSrc = item.Book.ImagePath.StartsWith("/") ? item.Book.ImagePath : "/Hinhsanpham/" + item.Book.ImagePath;
                            <img src="@imgSrc" width="60" onerror="this.style.display='none'" />
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.Book.Price.ToString("N0") đ</td>
                    <td>@((item.Quantity * item.Book.Price).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="color:green; font-weight:bold">Số lượng sách: @totalQty</td>
                <td colspan="3" style="text-align:right; font-weight:bold; font-size:1.1em; color:#c62828;">
                    Tổng tiền: @totalPrice.ToString("N0") đ
                </td>
            </tr>
        </tfoot>
    </table>

    <div style="text-align:right; margin-top:10px;">
        @Html.ActionLink("← Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-default", style = "margin-right:10px;" })
        @Html.ActionLink("Tiến hành đặt hàng →", "Checkout", "Cart", null, new { @class = "btn btn-success" })
    </div>
}