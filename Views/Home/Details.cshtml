@model WebBanSach.Models.Book

@{
    ViewBag.Title = Model.BookTitle;
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>@Model.BookTitle</h2>
<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            var imgSrc = Model.ImagePath.StartsWith("/") ? Model.ImagePath : "/Hinhsanpham/" + Model.ImagePath;
            <img src="@imgSrc" class="img-fluid" alt="@Model.BookTitle" style="max-height:400px;" onerror="this.style.display='none'" />
        }
        else
        {
            <div style="width:100%;height:300px;background:#eee;display:flex;align-items:center;justify-content:center;">
                <span>Khong co anh</span>
            </div>
        }
    </div>
    <div class="col-md-8">
        <table class="table table-bordered">
            <tr><td><strong>Ten sach:</strong></td><td>@Model.BookTitle</td></tr>
            <tr><td><strong>Tac gia:</strong></td><td>@Model.Author</td></tr>
            <tr><td><strong>Danh muc:</strong></td><td>@Model.Category.CategoryName</td></tr>
            <tr><td><strong>Nha xuat ban:</strong></td><td>@Model.Publisher.PublisherName</td></tr>
            <tr><td><strong>Ngay xuat ban:</strong></td><td>@Model.PublishedDate.ToString("dd/MM/yyyy")</td></tr>
            <tr><td><strong>Gia ban:</strong></td><td><span class="text-success" style="font-size:18px;">@Model.Price.ToString("N0") VND</span></td></tr>
            <tr><td><strong>So luong ton:</strong></td><td>@Model.Quantity</td></tr>
        </table>
        <div class="mb-3">
            <input type="number" id="quantity" value="1" min="1" max="@Model.Quantity" class="form-control" style="width:100px;display:inline-block;">
        </div>
        <button class="btn btn-success btn-lg" onclick="addToCart(@Model.BookID)">
            <i class="fas fa-shopping-cart"></i> Them vao gio hang
        </button>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-lg">
            <i class="fas fa-arrow-left"></i> Quay lai
        </a>
        <hr />
        <h4>Mo ta san pham:</h4>
        <p>@Html.Raw(Model.Description)</p>
    </div>
</div>

<script>
function addToCart(bookId) {
    var quantity = parseInt(document.getElementById("quantity").value);
    $.ajax({
        url: "@Url.Action("Add", "Cart")",
        type: "POST",
        data: { bookId: bookId, quantity: quantity },
        success: function (result) {
            alert(result.success ? result.message : result.message);
        }
    });
}
</script>