@model PagedList.IPagedList<WebBanSach.Models.Book>
@using PagedList.Mvc

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<style>
    .thumbnail { background: #fff; border: 1px solid #eee; padding: 10px; margin-bottom: 20px; text-align: center; }
    .thumbnail img { width: 200px; height: 260px; object-fit: cover; }
    .thumbnail h4 { font-size: 14px; text-align: center; margin-top: 10px; }
    .ratings span { color: #f5a623; font-size: 12px; }
    .page-title { font-size: 24px; margin-bottom: 20px; }
</style>

<h2 class="page-title">Trang chủ BookStore</h2>

<div class="row">
    @foreach (var sach in Model)
    {
        <div class="col-sm-4 col-lg-4 col-md-4">
            <div class="thumbnail">
                <a href="@Url.Action("Details", "Home", new { id = sach.BookID })">
                    @if (!string.IsNullOrEmpty(sach.ImagePath))
                    {
                        var imgSrc = sach.ImagePath.StartsWith("/") ? sach.ImagePath : "/Hinhsanpham/" + sach.ImagePath;
                        <img alt="@sach.BookTitle" src="@imgSrc" width="200" />
                    }
                    else
                    {
                        <img alt="no image" src="/Content/Images/no-image.png" width="200" />
                    }
                </a>
                <div>
                    <br />
                    <h4 style="text-align:center">@sach.BookTitle</h4>
                    <p></p>
                </div>
                <div class="ratings">
                    <p class="pull-right">15 reviews</p>
                    <p>
                        <span class="glyphicon glyphicon-star"></span>
                        <span class="glyphicon glyphicon-star"></span>
                        <span class="glyphicon glyphicon-star"></span>
                        <span class="glyphicon glyphicon-star"></span>
                        <span class="glyphicon glyphicon-star"></span>
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@Html.PagedListPager(Model, page => Url.Action("Index", new { page }))